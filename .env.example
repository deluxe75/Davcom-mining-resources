# Copy this file to .env and fill in the real values locally.
# Do not commit .env or any real SMTP password to GitHub.

# Application / deployment
APP_URL=http://localhost:3000

# Corporate Outbound Email Configuration (SMTP)
# Fill these in with your local credentials only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME="DAVCOM MINING RESOURCES NIG LTD"

# Primary notification targets
OFFICIAL_EMAIL=info@davcom.com.ng
SECONDARY_QUOTE_EMAIL=info@davcom.com.ng
QUOTE_NOTIFICATION_EMAIL=info@davcom.com.ng

# Optional cloud mail API
RESEND_API_KEY=

# Database settings
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=davcom_db
DB_USER=root
DB_PASSWORD=
