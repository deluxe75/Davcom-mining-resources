# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Corporate Outbound Email Configuration (SMTP)
# Optional: Set these to transmit quote notifications and customer receipts in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=info@davcom.com.ng
SMTP_FROM_NAME="DAVCOM MINING RESOURCES NIG LTD"

# Primary Notification Targets
QUOTE_NOTIFICATION_EMAIL=info@davcom.com.ng
SECONDARY_QUOTE_EMAIL=destinykalu45@gmail.com

# Optional Cloud Mail API (Resend / SendGrid - alternative to SMTP)
RESEND_API_KEY=

# Database Settings (Defaults to persistent SQLite if MySQL is not specified)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=davcom_db
DB_USER=root
DB_PASSWORD=
